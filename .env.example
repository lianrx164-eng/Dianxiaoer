# 聊天上游。CHAT_MODEL 要写上游认的真实模型名,没有别名这一层
# 当前使用 DeepSeek 官方 OpenAI 兼容端点(spec 原定端点由用户在本章验收阶段更换)
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=sk-xxx

# 提取任务的上游思考开关(如 EXTRACT_THINKING=disabled);留空则不发该参数,
# 换到不支持该参数的上游时删掉或留空即可,不用改代码
EXTRACT_THINKING=disabled

# MySQL 连接(本机无 Docker 时直连本机 MySQL 8.0;Docker 起库则用 root:root)
# 默认库名 mewhelp_ch02 与 README 一致,避免误连本机已有的 mewhelp 库
DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_ch02?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_test?charset=utf8mb4

# 嵌入:阿里云百炼系列(OpenAI 兼容网关)。BASE_URL 有内置默认值,换上游才需要填
EMBED_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_API_KEY=sk-xxx

# 重排:百炼原生 rerank(qwen3-rerank)。URL 有内置默认值;key 不填则复用 EMBED_API_KEY
# RERANK_URL=https://maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_API_KEY=sk-xxx

# ch08 工具系统
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0
