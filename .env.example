# 聊天上游。CHAT_MODEL 要写上游认的真实模型名,没有别名这一层
# 当前使用 DeepSeek 官方 OpenAI 兼容端点(spec 原定端点由用户在本章验收阶段更换)
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash
CHAT_API_KEY=sk-xxx

TOKEN_BUDGET=2000
# 提取任务的上游思考开关(如 EXTRACT_THINKING=disabled);留空则不发该参数,
# 换到不支持该参数的上游时删掉或留空即可,不用改代码
EXTRACT_THINKING=disabled

# MySQL 连接(本机无 Docker 时直连本机 MySQL 8.0;Docker 起库则用 root:root)
DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_test?charset=utf8mb4
